{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://crema-cqpl.local/schemas/llvm_memory_effects_v1.schema.json",
  "title": "CREMA LLVM 16 memory/effect evidence v1",
  "type": "object",
  "required": [
    "schema",
    "llvm_version",
    "explicit_basis",
    "tli_basis",
    "modules"
  ],
  "properties": {
    "schema": {
      "const": "llvm_memory_effects_v1"
    },
    "llvm_version": {
      "const": "16.0.4"
    },
    "explicit_basis": {
      "const": "llvm16_explicit_input_ir_v1"
    },
    "tli_basis": {
      "const": "llvm16_tli_libfunc_attrs_v1"
    },
    "modules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/module"
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "access": {
      "enum": [
        "none",
        "read",
        "write",
        "readwrite"
      ]
    },
    "memory": {
      "type": "object",
      "required": [
        "argmem",
        "inaccessiblemem",
        "other",
        "encoded"
      ],
      "properties": {
        "argmem": {
          "$ref": "#/$defs/access"
        },
        "inaccessiblemem": {
          "$ref": "#/$defs/access"
        },
        "other": {
          "$ref": "#/$defs/access"
        },
        "encoded": {
          "type": "integer",
          "minimum": 0,
          "maximum": 63
        }
      },
      "additionalProperties": false
    },
    "formal": {
      "type": "object",
      "required": [
        "index",
        "pointer_typed",
        "nofree",
        "nocapture",
        "returned",
        "readnone",
        "readonly",
        "writeonly",
        "allocptr",
        "allocalign"
      ],
      "properties": {
        "index": {
          "type": "integer",
          "minimum": 0
        },
        "pointer_typed": {
          "type": "boolean"
        },
        "nofree": {
          "type": "boolean"
        },
        "nocapture": {
          "type": "boolean"
        },
        "returned": {
          "type": "boolean"
        },
        "readnone": {
          "type": "boolean"
        },
        "readonly": {
          "type": "boolean"
        },
        "writeonly": {
          "type": "boolean"
        },
        "allocptr": {
          "type": "boolean"
        },
        "allocalign": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "snapshot": {
      "type": "object",
      "required": [
        "nofree",
        "nosync",
        "willreturn",
        "nobuiltin",
        "optnone",
        "memory_explicit",
        "memory",
        "alloc_kind",
        "alloc_family",
        "return_noalias",
        "alloc_size",
        "formals"
      ],
      "properties": {
        "nofree": {
          "type": "boolean"
        },
        "nosync": {
          "type": "boolean"
        },
        "willreturn": {
          "type": "boolean"
        },
        "nobuiltin": {
          "type": "boolean"
        },
        "optnone": {
          "type": "boolean"
        },
        "memory_explicit": {
          "type": "boolean"
        },
        "memory": {
          "$ref": "#/$defs/memory"
        },
        "alloc_kind": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "alloc",
              "realloc",
              "free",
              "uninitialized",
              "zeroed",
              "aligned"
            ]
          }
        },
        "alloc_family": {
          "type": [
            "string",
            "null"
          ]
        },
        "return_noalias": {
          "type": "boolean"
        },
        "alloc_size": {
          "oneOf": [
            {
              "type": "object",
              "required": [
                "element_size_arg",
                "num_elements_arg"
              ],
              "properties": {
                "element_size_arg": {
                  "type": "integer",
                  "minimum": 0
                },
                "num_elements_arg": {
                  "type": [
                    "integer",
                    "null"
                  ],
                  "minimum": 0
                }
              },
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        },
        "formals": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/formal"
          }
        }
      },
      "additionalProperties": false
    },
    "function": {
      "type": "object",
      "required": [
        "name",
        "is_declaration",
        "origin_explicit",
        "explicit",
        "tli_recognized",
        "tli_libfunc",
        "origin_inferred",
        "tli_inferred",
        "tli_changed"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "is_declaration": {
          "type": "boolean"
        },
        "origin_explicit": {
          "const": "explicit_input_ir"
        },
        "explicit": {
          "$ref": "#/$defs/snapshot"
        },
        "tli_recognized": {
          "type": "boolean"
        },
        "tli_libfunc": {
          "type": [
            "string",
            "null"
          ]
        },
        "origin_inferred": {
          "const": "llvm_tli_inferred"
        },
        "tli_inferred": {
          "$ref": "#/$defs/snapshot"
        },
        "tli_changed": {
          "type": "boolean"
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "tli_recognized": {
                "const": true
              }
            },
            "required": [
              "tli_recognized"
            ]
          },
          "then": {
            "properties": {
              "tli_libfunc": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "tli_recognized": {
                "const": false
              }
            },
            "required": [
              "tli_recognized"
            ]
          },
          "then": {
            "properties": {
              "tli_libfunc": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "callsite": {
      "type": "object",
      "required": [
        "caller",
        "ordinal",
        "direct",
        "callee",
        "callsite_memory_explicit",
        "effective_memory"
      ],
      "properties": {
        "caller": {
          "type": "string"
        },
        "ordinal": {
          "type": "integer",
          "minimum": 0
        },
        "direct": {
          "type": "boolean"
        },
        "callee": {
          "type": [
            "string",
            "null"
          ]
        },
        "callsite_memory_explicit": {
          "type": "boolean"
        },
        "effective_memory": {
          "$ref": "#/$defs/memory"
        }
      },
      "additionalProperties": false
    },
    "module": {
      "type": "object",
      "required": [
        "input",
        "target_triple",
        "functions",
        "callsites_explicit",
        "callsites_tli_inferred",
        "input_ir_verified",
        "tli_clone_verified"
      ],
      "properties": {
        "input": {
          "type": "string",
          "minLength": 1
        },
        "target_triple": {
          "type": "string"
        },
        "functions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/function"
          }
        },
        "callsites_explicit": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/callsite"
          }
        },
        "callsites_tli_inferred": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/callsite"
          }
        },
        "input_ir_verified": {
          "const": true
        },
        "tli_clone_verified": {
          "const": true
        }
      },
      "additionalProperties": false
    }
  }
}
