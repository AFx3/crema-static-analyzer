# User-facing full-profile double-free query.
# The formula is intentionally identical to queries_v2/double_free_alloc_state.cqpl.
# v2+v3+v4 are declared explicitly so every currently supported typed
# deallocation contract family is admissible on the analyzed artifact.
requires allocation_state_v1;
requires allocation_contracts_v2;
requires allocation_contracts_v3;
requires allocation_contracts_v4;

exists_alloc a. EF (
  alloc(a) &&
  EX EF (
    drop_l(a) &&
    EX E[(!alloc_l(a)) U drop_l(a)]
  )
)
