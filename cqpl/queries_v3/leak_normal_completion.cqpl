# Allocation-centric MAY-state leak pattern.
# Allocazione non recuperata su normal completion.
# This is intentionally the same query contract/formula as the validated
# queries_v2/leak_alloc_state.cqpl: allocation contracts do not strengthen this
# lifecycle-state property and are therefore not added as artificial gates.
requires allocation_state_v1;
requires typed_edge_flow_v1;
assessment_scope normal_execution;

exists_alloc a. EF (
  alloc(a) &&
  EX EG !drop(a)
)
