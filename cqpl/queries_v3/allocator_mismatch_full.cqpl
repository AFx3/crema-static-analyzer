# User-facing full-profile allocator/deallocator-family mismatch query.
# The formula is intentionally identical to queries_v2/allocator_mismatch_ub_v2.cqpl.
# v2+v3+v4 are explicit because all currently supported producer-certified
# deallocator contract vocabularies may contribute family evidence.
requires allocation_contracts_v2;
requires allocation_contracts_v3;
requires allocation_contracts_v4;

exists_alloc a. EF (
  alloc_l(a) &&
  EX EF allocator_mismatch_l(a)
)
