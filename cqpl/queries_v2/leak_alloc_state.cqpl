# Allocation-centric MAY-state leak pattern.
# Allocazione non recuperata su normal completion
requires allocation_state_v1;      # abilit i predicati astratti alloc(a) e drop(a) dove a è un'abstract allocation
requires typed_edge_flow_v1;       # richiedo che l'annotated ICFG distingua normal-unwind edge, serve per l'assesment
assessment_scope normal_execution; # se manca la capability requires typed_edge_flow_v1; fallisce. I finding vengono valutati su normal execution

exists_alloc a. EF (
  alloc(a) &&
  EX EG !drop(a)
)
